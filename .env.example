APP_NAME="Assistente Delivery IA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=delivery_ia
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# database (padrão) ou redis, se houver um Redis disponível
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Inteligência Artificial (Google Gemini) ---
# Chave em https://aistudio.google.com/apikey — nunca versionar a chave real.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Modelo usado automaticamente quando o principal falha (429/5xx/timeout)
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT=60
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=2048
# Nível de raciocínio (minimal | low | medium | high)
AI_THINKING_LEVEL=low
# Limite de perguntas por minuto por visitante
AI_RATE_LIMIT_PER_MINUTE=8
# Quantas mensagens anteriores da conversa são reenviadas como memória
AI_HISTORY_MESSAGES=6
# Tempo de cache (segundos) dos resultados das consultas analíticas
ANALYTICS_CACHE_TTL=300

# Estabelecimento usado na demonstração pública
DEMO_STORE_ID=1

VITE_APP_NAME="${APP_NAME}"
